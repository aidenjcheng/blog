{
  "name": "nextjs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bunx --no-install next dev",
    "build": "bun run lint && bun run mdx:timestamps && bunx --no-install next build",
    "start": "bunx --no-install next start",
    "postbuild": "bunx --no-install next-sitemap",
    "mdx:timestamps": "bun ./scripts/update-mdx-timestamps",
    "lint:style": "bunx --no-install stylelint \"**/*.css\" --fix",
    "lint:biome": "bunx --no-install biome check --fix --unsafe .",
    "lint:prettier": "bunx --no-install prettier . --write --log-level warn",
    "lint": "bun run lint:style && bun run lint:prettier && bun run lint:biome"
  },
  "dependencies": {
    "@base-ui-components/react": "1.0.0-alpha.7",
    "@base-ui/react": "^1.2.0",
    "@grizzshutsdown/simpleplayer": "^0.1.20",
    "@radix-ui/colors": "^3.0.0",
    "@types/mdx": "^2.0.13",
    "@vercel/analytics": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^13.1.1",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.452.0",
    "motion": "^12.0.0",
    "next": "14.2.15",
    "next-mdx-remote": "^6.0.0",
    "next-sitemap": "^4.2.3",
    "next-themes": "^0.3.0",
    "next-view-transitions": "^0.3.2",
    "postcss-nested": "^6.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rehype-pretty-code": "^0.14.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.0",
    "shiki": "^1.22.0",
    "tailwind-merge": "^2.5.4",
    "tailwindcss-animate": "^1.0.7",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.3",
    "@ianvs/prettier-plugin-sort-imports": "^4.3.1",
    "@types/node": "^22.7.6",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "eslint": "^9.12.0",
    "eslint-config-next": "14.2.15",
    "postcss": "^8.4.47",
    "prettier": "3.3.3",
    "stylelint": "^16.10.0",
    "stylelint-config-recess-order": "^5.1.1",
    "stylelint-config-standard": "^36.0.1",
    "stylelint-order": "^6.0.4",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3"
  }
}
